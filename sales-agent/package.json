{
  "name": "sales-agent",
  "version": "1.0.0",
  "description": "CAP service served as an A2A agent via @cap-js/agents, with a chat UI.",
  "private": true,
  "dependencies": {
    "@sap/cds": "^9",
    "@cap-js/agents": "^0.9",
    "@cap-js/sqlite": "^2",
    "express": "^4"
  },
  "scripts": {
    "watch": "cds watch",
    "start": "cds-serve",
    "hybrid": "cds watch --profile hybrid"
  },
  "cds": {
    "requires": {
      "db": "sqlite",
      "llm": {
        "kind": "aicore",
        "model": "anthropic--claude-4.6-sonnet",
        "[development]": { "kind": "mock" }
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "alice": { "password": "", "roles": ["agent", "admin"] },
          "bob": { "password": "", "roles": ["agent"] }
        }
      }
    },
    "query": {
      "limit": { "default": 50, "max": 500 }
    }
  }
}
