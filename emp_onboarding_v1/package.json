{
  "name": "emp_onboarding_v1",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@cap-js/mcp": "^1.4.3",
    "@sap-cloud-sdk/http-client": "^4.8.0",
    "@sap-cloud-sdk/resilience": "^4.8.0",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "axios": "^1.7.0",
    "mbt": "^1.2.49"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-emponboarding_ui": "cds watch --open com.mindset.empondoard.ui.emponboardingui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy emp_onboarding_v1 --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "mocked"
      },
      "BPA_WORKFLOW": {
        "kind": "rest",
        "credentials": {
          "destination": "BPA_WORKFLOW"
        }
      },
      "destinations": true
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/emponboarding_ui"
  ]
}
